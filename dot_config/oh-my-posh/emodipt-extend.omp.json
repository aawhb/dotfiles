{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": { "style": "full" },
          "template": "{{ .Path }}",
          "foreground": "#61AFEF",
          "type": "path",
          "style": "plain",
          "min_width": 100
        },
        {
          "options": { "style": "unique" },
          "template": "{{ .Path }}",
          "foreground": "#61AFEF",
          "type": "path",
          "style": "plain",
          "max_width": 99
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "branch_icon": "",
            "branch_gone_icon": "≢",
            "fetch_status": true,
            "fetch_upstream_icon": false
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }}",
          "foreground": "#F3C267",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ]
        },
        {
          "options": {
            "display_mode": "context",
            "tooling": ["uv", "python", "py"],
            "cache_duration": "30s"
          },
          "template": "{{ if not .Error }} py:{{ .Major }}.{{ .Minor }}{{ if .Venv }}({{ .Venv }}){{ end }}{{ end }}",
          "foreground": "#61AFEF",
          "type": "python",
          "style": "plain"
        },
        {
          "options": {
            "display_mode": "context",
            "cache_duration": "30s"
          },
          "template": " node:{{ .Major }}.{{ .Minor }}",
          "foreground": "#98C379",
          "type": "node",
          "style": "plain"
        },
        {
          "options": {
            "display_mode": "context",
            "fetch_sdk_version": true,
            "cache_duration": "30s"
          },
          "template": " dotnet:{{ .Major }}.{{ .Minor }}",
          "foreground": "#C678DD",
          "type": "dotnet",
          "style": "plain"
        },
        {
          "template": "{{ if .SSHSession }} {{ .UserName }}@{{ .HostName }}{{ end }}",
          "foreground": "#56B6C2",
          "type": "session",
          "style": "plain"
        },
        {
          "template": " ADMIN",
          "foreground": "#E06C75",
          "type": "root",
          "style": "plain"
        },
        {
          "options": { "always_enabled": false },
          "template": "{{ if and .Executed (gt .Code 0) }} ✗{{ .Code }}{{ end }}",
          "foreground": "#E06C75",
          "type": "status",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": false,
            "threshold": 500,
            "style": "roundrock"
          },
          "template": " {{ .FormattedMs }}",
          "foreground": "#b8ff75",
          "type": "executiontime",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ]
        },
        {
          "template": " ❯",
          "foreground": "#E06C75",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": false
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#E06C75",
    "template": "[{{ now | date \"15:04\" }}] ❯ "
  },
  "version": 4,
  "final_space": true
}
